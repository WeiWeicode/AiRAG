# pyenv
#   For a library or app, you might want to share your .python-version.
#   Document, and uncomment if necessary:
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if you want to keep Pipfile.lock out of git:
#Pipfile.lock

# poetry
#   Using Poetry supports standard workflow, but you can ignore poetry.lock if you want.
#poetry.lock

# pdm
#   Similar to Pipfile.lock / poetry.lock, pdm.lock is usually shared in version control
#pdm.lock
#   pdm persistent configuration file
.pdm-python.json
.pdm-build/

# PEP 582; project local packages directory (used by pdm)
__pypackages__/

