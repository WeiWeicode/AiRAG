# AiRAG 後端環境變數範本
# 複製為 .env 後依實際部署環境調整。
#
# 若後端跑在 docker-compose 容器內（docker-compose.yml 已設定
# extra_hosts: host.docker.internal:host-gateway），要連到「宿主機」上
# 執行的 Ollama / llama.cpp / LM Studio 時，請用 host.docker.internal
# 取代 localhost；若後端是直接用 uvicorn 跑在本機，才用 localhost。

# 認證設定
AUTH_USERNAME=admin
AUTH_PASSWORD_HASH=
# JWT_SECRET 產生指令（擇一執行後貼上結果）：
#   openssl rand -hex 32
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=請自行產生一組隨機字串
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ============================================================
# 對話 LLM 服務路徑（OpenAI 相容 /chat/completions，vLLM / Ollama / LM Studio 皆適用）
# ============================================================

# -- 公司地端（vLLM）--
VLLM_BASE_URL=http://localhost:8080/v1
VLLM_MODEL=Qwen3.6-35B-A3B-FP8
# 模型上下文長度上限（即 vLLM 啟動時的 --max-model-len）。後端會在送出前自動裁切 max_tokens，
# 避免呼叫端帶入過大的 max_tokens 造成「prompt + max_tokens 超出上限」被回 400。
# 設 0 或不設時會改用 /tokenize 回報的 max_model_len 自動偵測（VLLM_USE_TOKENIZE_ENDPOINT=false
# 時才會真的完全停用裁切）；此處填值可手動下修以預留更多餘裕。
VLLM_MAX_MODEL_LEN=0
# 自動裁切時預留的安全邊際（字元估算與實際 tokenizer 有落差，chat template 本身也佔 token）
VLLM_CONTEXT_SAFETY_MARGIN=4096
# 是否呼叫 vLLM /tokenize 取得精確的 prompt token 數（多一次輕量 HTTP，取不到時自動退回字元估算）
VLLM_USE_TOKENIZE_ENDPOINT=true

# -- 在家：Ollama（docker-compose 環境下用 host.docker.internal）--
# VLLM_BASE_URL=http://host.docker.internal:11434/v1
# VLLM_MODEL=qwen2.5:14b

# -- 在家：LM Studio --
# VLLM_BASE_URL=http://host.docker.internal:1234/v1
# VLLM_MODEL=qwen2.5-14b-instruct

# ============================================================
# Embedding 服務路徑（用於文件切塊向量化與查詢向量化）
# ============================================================

# -- 公司地端（llama.cpp 原生 /embedding 端點）--
LLAMACPP_BASE_URL=http://localhost:8081
EMBEDDING_MODEL=Qwen3-Embedding-8B-Q8_0.gguf
EMBEDDING_API_STYLE=llamacpp

# -- 在家：Ollama（原生 /api/embeddings 端點）--
# LLAMACPP_BASE_URL=http://host.docker.internal:11434
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_API_STYLE=ollama

# -- 在家：LM Studio 或 llama.cpp 的 OpenAI 相容 /v1/embeddings 端點 --
# LLAMACPP_BASE_URL=http://host.docker.internal:1234
# EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
# EMBEDDING_API_STYLE=openai

# ============================================================
# llama.cpp 服務路徑（Instruct 語義化，將查詢轉換為結構化 JSON）
# 注意：此變數不含 /v1，程式碼會自動補上 /v1/chat/completions
# ============================================================

# -- 公司地端（llama.cpp）--
DenseVector_LLAMACPP_BASE_URL=http://localhost:8082
DenseVector_INSTRUCT_MODEL=Qwen3VL-8B-Instruct-Q4_K_M.gguf

# -- 在家：Ollama --
# DenseVector_LLAMACPP_BASE_URL=http://host.docker.internal:11434
# DenseVector_INSTRUCT_MODEL=qwen2.5:14b

# -- 在家：LM Studio --
# DenseVector_LLAMACPP_BASE_URL=http://host.docker.internal:1234
# DenseVector_INSTRUCT_MODEL=qwen2.5-14b-instruct

# Qdrant 向量資料庫
QDRANT_HOST=localhost
QDRANT_PORT=6333

# MongoDB 應用資料庫
# 正式環境的 MongoDB 已啟用認證，連線字串必須帶帳密與 authSource：
#   MONGODB_URL=mongodb://airag_admin:<密碼>@localhost:27017/?authSource=admin
# authSource 指向帳號建立所在的 db（airag_admin 建於 admin），寫錯一律認證失敗。
# 密碼請限用英數與 - _ .，含 @ : / ? # [ ] % 等字元會破壞 URI 解析（需 percent-encode）。
# 注意 docker compose 的 environment: 會覆蓋此檔（load_dotenv 不覆寫既有環境變數），
# 容器環境請改 docker-compose.yml，此處僅供宿主機直接執行時使用。
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=airag
# python -c "import secrets; print(secrets.token_urlsafe(32))"
QDRANT_API_KEY=

# SQL Server 既有知識庫 (唯讀，ODBC 連線)
SQLSERVER_CONNECTION_STRING=

# 預設參數設定
DEFAULT_TOP_K=5
DEFAULT_SCORE_THRESHOLD=0.7
DEFAULT_CHUNK_SIZE=512
DEFAULT_CHUNK_OVERLAP=50
FEEDBACK_BOOST_WEIGHT=0.2
# Parent-Child 還原父段落時單一父段落的 token 上限（0 = 不限制）。超過時以命中的子段落為中心取窗。
PARENT_MERGE_MAX_TOKENS=6000
# 還原父段落時以命中子段落為中心、單側最多取幾個兄弟節點（0 = 不限制）。在 Qdrant 查詢階段就過濾，
# 避免整份文件被歸成同一個 parent 時撈回數百筆兄弟節點。圖片型兄弟節點不受此視窗限制。
PARENT_SIBLING_WINDOW=8
# 切分階段單一父段落的 token 上限（0 = 不限制）。PARENT_MERGE_MAX_TOKENS 是事後截斷，這個是從源頭防止切壞。
PARENT_MAX_TOKENS=1500
# PDF 以頁面為父段落邊界時，單一父段落最多聚合幾頁（0 = 只受 PARENT_MAX_TOKENS 限制）
PDF_PARENT_MAX_PAGES=3
# 以字級／粗體偵測 PDF 標題階層，偵測不到（掃描檔、排版無字級變化）會自動退回頁面邊界
PDF_HEADING_DETECTION=true
PDF_HEADING_SIZE_RATIO=1.15

# 檢索內容分批摘要：THRESHOLD 決定「整份脈絡多大才啟動摘要」，BATCH 決定「每批送多少進 LLM」，
# 兩者必須分開設定，BATCH 過大會讓單一批次就超過模型上下文而失敗。
DEFAULT_CONTEXT_SUMMARIZE_THRESHOLD_TOKENS=50000
CONTEXT_SUMMARIZE_BATCH_TOKENS=8000
CONTEXT_SUMMARIZE_MAX_ROUNDS=3

# 內嵌圖片描述與 ingest 背景任務時間上限
IMAGE_CAPTION_CONCURRENCY=3
IMAGE_CAPTION_TIMEOUT=180
IMAGE_CAPTION_MAX_ATTEMPTS=3
IMAGE_CAPTION_RETRY_DELAY=5
INGEST_JOB_TIMEOUT=7200
INGEST_JOB_MAX_TRIES=2

# 停用 huggingface_hub 的 agent-harness 偵測遙測（fastembed 下載模型時觸發，非必要對外請求）
HF_HUB_DISABLE_TELEMETRY=1


MONGO_ADMIN_PASSWORD=<Step 2 設定的密碼>